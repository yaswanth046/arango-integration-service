{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:node/recommended"
  ],
  "plugins": [
    "node"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "warn",
    "eqeqeq": "error",
    "curly": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "indent": ["error", 2],
    "arrow-body-style": ["error", "as-needed"],
    "object-shorthand": ["error", "always"],
    "max-depth": ["error", 4],                  // Max 4 nested blocks
    "max-nested-callbacks": ["error", 3],       // Max 3 nested callbacks
    "complexity": ["warn", 15],                 // Warn if cyclomatic complexity > 10
    "max-params": ["warn", 4],                  // Warn if function has more than 4 params
    "max-lines-per-function": ["warn", 250],     // Warn if function exceeds 250 lines
    "max-lines": ["warn", 300],                 // Warn if file exceeds 300 lines
    "max-len": ["warn", { "code": 100 }],       // Warn if line exceeds 100 chars
    "max-statements-per-line": ["error", { "max": 1 }],
    "prefer-const": "error",
    "no-var": "error",
    "strict": ["error", "global"],
    "require-await": "error"
  }
}